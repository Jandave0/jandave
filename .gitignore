# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js build outputs
/.next/
/out/
/build
/dist
/.turbo/

# environment files & local secrets
.env
.env*
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
credentials.json
secrets/
private/

# SSL / TLS certificates and private keys
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.keystore
*.jks

# debug and logs
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local design & temporary scratch folders
/image/
/scratch/
/temp/
/tmp/

# operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & editors
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.sw?

# AI agent local cache & metadata
.agents/
.claude/
.gemini/
